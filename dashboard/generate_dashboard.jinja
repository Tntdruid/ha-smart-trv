{#- Smart TRV dashboard generator.
    Paste everything into Developer tools -> Template. Copy the output on the right and paste it into
    a new dashboard: Edit dashboard -> ⋮ -> Raw configuration editor.
    Makes one view per Smart TRV, using whatever your entities are actually called. -#}
{%- set rooms = integration_entities('smart_trv') | select('match', 'climate[.]') | list -%}
{%- if not rooms -%}
# No Smart TRV found. Is the integration added, and has Home Assistant been restarted?
{%- else -%}
title: Varme
views:
{%- set ns = namespace(problems=[]) %}
{%- for c in rooms %}
{%- set pb = device_entities(device_id(c)) | select('search', '^binary_sensor[.].*_problem$') | first %}
{%- if pb %}{% set ns.problems = ns.problems + [(pb, state_attr(c, 'friendly_name') or c)] %}{% endif %}
{%- endfor %}
  - title: Hele huset
    path: hele-huset
    type: sections
    max_columns: 4
    sections:
{%- if ns.problems %}
      - type: grid
        cards:
          - type: heading
            heading: TRV-problemer
          - type: entities
            state_color: true
            entities:
{%- for pb, name in ns.problems %}
              - entity: {{ pb }}
                name: {{ name | tojson }}
{%- endfor %}
{%- endif %}
{%- for c in rooms %}
      - type: grid
        cards:
          - type: custom:smart-trv-card
            entity: {{ c }}
            show_graph: false
{%- endfor %}
{%- for c in rooms %}
{%- set ents = device_entities(device_id(c)) | select('match', 'sensor[.]') | list %}
{%- set s_status = ents | select('search', '_status$') | first %}
{%- set s_set = ents | select('search', '_trv_setpoint$') | first %}
{%- set s_trv = ents | select('search', '_trv_temperature$') | first %}
{%- set s_err = ents | select('search', '_error$') | first %}
{%- set s_p = ents | select('search', '_p_term$') | first %}
{%- set s_i = ents | select('search', '_integral$') | first %}
  - title: {{ (state_attr(c, 'friendly_name') or c) | tojson }}
    path: {{ c.split('.')[1] | replace('_', '-') }}
    type: sections
    max_columns: 3
    sections:
      - type: grid
        cards:
          - type: heading
            heading: Lige nu
          - type: custom:smart-trv-card
            entity: {{ c }}
            show_graph: false
      - type: grid
        column_span: 2
        cards:
          - type: heading
            heading: Rummet
          - type: history-graph
            title: Rumtemperatur og mål (24 t)
            hours_to_show: 24
            entities:
              - entity: {{ c }}
{%- if s_set or s_trv %}
          - type: history-graph
            title: Hvad TRV'en får besked på (24 t)
            hours_to_show: 24
            entities:
{%- for s in [s_set, s_trv] if s %}
              - entity: {{ s }}
{%- endfor %}
{%- endif %}
{%- if s_err or s_p or s_i %}
          - type: history-graph
            title: Regulatoren (48 t)
            hours_to_show: 48
            entities:
{%- for s in [s_err, s_p, s_i] if s %}
              - entity: {{ s }}
{%- endfor %}
{%- endif %}
          - type: logbook
            title: Hvad den har gjort
            hours_to_show: 24
            target:
              entity_id:
                - {{ c }}
{%- if s_status %}
                - {{ s_status }}
{%- endif %}
{%- endfor %}
{%- endif %}
