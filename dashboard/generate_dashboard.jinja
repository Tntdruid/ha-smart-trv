{#- Smart TRV dashboard generator.
    Paste everything into Developer tools -> Template. Copy the output on the right and paste it into
    a new dashboard: Edit dashboard -> ⋮ -> Raw configuration editor.
    Makes one view per Smart TRV, using whatever your entities are actually called.
    Language: 'auto' follows Home Assistant (Danish or English); set 'da' or 'en' to force it. -#}
{%- set lang = 'auto' -%}
{%- set rooms = integration_entities('smart_trv') | select('match', 'climate[.]') | list -%}
{%- if not rooms -%}
# No Smart TRV found. Is the integration added, and has Home Assistant been restarted?
{%- else -%}
{#- Templates can't read HA's language, but they can read a translated state: a Danish
    status ("Varmer", "Ventil lukket", ...) means Danish. -#}
{%- if lang == 'auto' -%}
{%- set probe = device_entities(device_id(rooms[0])) | select('search', '^sensor[.].*_status$') | first -%}
{%- set lang = 'da' if probe and state_translated(probe) in ['Varmer', 'Ventil lukket', 'Vindue åbent', 'Slukket', 'Ingen rummåling'] else 'en' -%}
{%- endif -%}
{%- set T = {
  'da': {'title': 'Varme', 'house': 'Hele huset', 'house_path': 'hele-huset', 'problems': 'TRV-problemer',
         'now': 'Lige nu', 'room': 'Rummet', 'g_room': 'Rumtemperatur og mål (24 t)',
         'g_trv': "Hvad TRV'en får besked på (24 t)", 'g_ctrl': 'Regulatoren (48 t)', 'log': 'Hvad den har gjort'},
  'en': {'title': 'Heating', 'house': 'Whole house', 'house_path': 'whole-house', 'problems': 'TRV problems',
         'now': 'Now', 'room': 'The room', 'g_room': 'Room temperature and target (24 h)',
         'g_trv': 'What the TRV is told (24 h)', 'g_ctrl': 'The controller (48 h)', 'log': 'What it has done'},
}[lang] -%}
title: {{ T.title }}
views:
{%- set ns = namespace(problems=[]) %}
{%- for c in rooms %}
{%- set pb = device_entities(device_id(c)) | select('search', '^binary_sensor[.].*_problem$') | first %}
{%- if pb %}{% set ns.problems = ns.problems + [(pb, state_attr(c, 'friendly_name') or c)] %}{% endif %}
{%- endfor %}
  - title: {{ T.house | tojson }}
    path: {{ T.house_path }}
    type: sections
    max_columns: 4
    sections:
{%- if ns.problems %}
      - type: grid
        cards:
          - type: heading
            heading: {{ T.problems | tojson }}
          - type: entities
            state_color: true
            entities:
{%- for pb, name in ns.problems %}
              - entity: {{ pb }}
                name: {{ name | tojson }}
{%- endfor %}
{%- endif %}
{%- for c in rooms %}
      - type: grid
        cards:
          - type: custom:smart-trv-card
            entity: {{ c }}
            show_graph: false
{%- endfor %}
{%- for c in rooms %}
{%- set ents = device_entities(device_id(c)) | select('match', 'sensor[.]') | list %}
{%- set s_status = ents | select('search', '_status$') | first %}
{%- set s_set = ents | select('search', '_trv_setpoint$') | first %}
{%- set s_trv = ents | select('search', '_trv_temperature$') | first %}
{%- set s_err = ents | select('search', '_error$') | first %}
{%- set s_p = ents | select('search', '_p_term$') | first %}
{%- set s_i = ents | select('search', '_integral$') | first %}
  - title: {{ (state_attr(c, 'friendly_name') or c) | tojson }}
    path: {{ c.split('.')[1] | replace('_', '-') }}
    type: sections
    max_columns: 3
    sections:
      - type: grid
        cards:
          - type: heading
            heading: {{ T.now | tojson }}
          - type: custom:smart-trv-card
            entity: {{ c }}
            show_graph: false
      - type: grid
        column_span: 2
        cards:
          - type: heading
            heading: {{ T.room | tojson }}
          - type: history-graph
            title: {{ T.g_room | tojson }}
            hours_to_show: 24
            entities:
              - entity: {{ c }}
{%- if s_set or s_trv %}
          - type: history-graph
            title: {{ T.g_trv | tojson }}
            hours_to_show: 24
            entities:
{%- for s in [s_set, s_trv] if s %}
              - entity: {{ s }}
{%- endfor %}
{%- endif %}
{%- if s_err or s_p or s_i %}
          - type: history-graph
            title: {{ T.g_ctrl | tojson }}
            hours_to_show: 48
            entities:
{%- for s in [s_err, s_p, s_i] if s %}
              - entity: {{ s }}
{%- endfor %}
{%- endif %}
          - type: logbook
            title: {{ T.log | tojson }}
            hours_to_show: 24
            target:
              entity_id:
                - {{ c }}
{%- if s_status %}
                - {{ s_status }}
{%- endif %}
{%- endfor %}
{%- endif %}
